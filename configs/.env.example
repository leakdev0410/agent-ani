# Copy file này thành .env rồi điền giá trị thật, đừng commit .env
ANI_TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
# Bắt buộc: ID của đúng private chat với owner. Với private chat, đặt bằng Telegram user ID của owner.
ANI_ALLOWED_CHAT_ID=

# Tuỳ chỉnh, có giá trị mặc định hợp lý nếu bỏ trống. Đổi model lúc bot đang chạy qua lệnh
# Telegram /model (xem README) — 2 dòng dưới đây chỉ là default khi khởi động lần đầu:
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_EMBEDDING_MODEL=             # tùy chọn; rỗng = search_memory chỉ dùng FTS5. Điền model embedding OpenRouter để bật index semantic nền.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ANI_MEMORY_DB=./memory.db          # SQLite, nguồn thật của bộ nhớ (core state/diary/observations/topics)
# ANI_MEMORY_DIR=./memory            # chỉ dùng để seed memory.db 1 lần lúc DB còn trống
# ANI_OFFSET_FILE=offset.txt         # offset Telegram getUpdates
# ANI_PERSONA_PATH=                    # rỗng = persona nhúng sẵn (internal/persona/ani.txt)
# ANI_GROK_PROMPT_PATH=                # alias cũ của ANI_PERSONA_PATH, không còn mặc định ani-grok
# ANI_POLL_TIMEOUT_SEC=30
# ANI_ALLOWED_USER_ID=1
# ANI_MAX_TELEGRAM_RESPONSE_BYTES=4194304
# ANI_MAX_OPENROUTER_RESPONSE_BYTES=4194304
# ANI_MAX_IMAGE_BYTES=20971520
# ANI_MAX_SYSTEM_PROMPT_BYTES=262144
# ANI_MAX_MODEL_REPLY_BYTES=65536
# ANI_MAX_TOOL_RESULT_BYTES=65536
# ANI_MAX_TOOL_TOTAL_BYTES=262144
# ANI_MAX_IMPORT_FILE_BYTES=2097152
